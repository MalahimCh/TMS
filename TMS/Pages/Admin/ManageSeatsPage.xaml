<Page x:Class="TMS.Pages.Admin.ManageSeatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:TMS.Controls.Admin"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Manage Seats"
      Background="#F0F2F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ SIDEBAR ============ -->
        <Border Background="#17358A" Grid.Column="0">
            <StackPanel Margin="0,20,0,0">
                <!-- Back Button -->
                <Button Click="Back_Click"
                        Height="50"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        HorizontalContentAlignment="Left"
                        Padding="20,0,0,0"
                        Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" Margin="0,0,10,0"/>
                        <TextBlock Text="Back" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="Manage Seats"
                           FontSize="22"
                           Foreground="White"
                           FontWeight="Bold"
                           Margin="25,0,0,20" />
            </StackPanel>
        </Border>

        <!-- ============ MAIN CONTENT ============ -->
        <Grid Grid.Column="1" Margin="20">
            <!-- White Card Container -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.1" Color="Black"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Blue Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Selection Area -->
                        <RowDefinition Height="*"/>
                        <!-- Seat Layout -->
                    </Grid.RowDefinitions>

                    <!-- 1. Header -->
                    <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="12,12,0,0" Padding="20">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="EventSeat" Width="24" Height="24" Foreground="White" Margin="0,0,10,0"/>
                            <TextBlock Text="Seat Availability Manager" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Selection Area -->
                    <StackPanel Grid.Row="1" Margin="30,25,30,10">
                        <TextBlock Text="Select Bus" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>

                        <Border Background="#F7F9FC" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Height="40">
                            <ComboBox x:Name="BusDropdown" 
                                      Padding="10,8" 
                                      Background="Transparent" 
                                      BorderThickness="0"
                                      SelectionChanged="BusDropdown_SelectionChanged"
                                      FontSize="14"
                                      materialDesign:HintAssist.Hint="Choose a bus to manage..."/>
                        </Border>
                    </StackPanel>

                    <!-- 3. Seat Layout Control -->
                    <!-- This loads your custom UserControl inside the card -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,20">
                        <controls:AdminSeatLayoutControl x:Name="SeatLayout" Margin="20,0"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>
<Page x:Class="TMS.Pages.Admin.ManageSeatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:TMS.Controls.Admin"
      Background="#F5F7FF">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#17358A" Grid.Column="0">
            <StackPanel Margin="20">
                <Button Content="← Back" Click="Back_Click" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,30"/>
                <TextBlock Text="Manage Seats" FontSize="22" Foreground="White" FontWeight="Bold" Margin="0,0,0,20" />
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BUS DROPDOWN -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,0,10">
                <TextBlock Text="Select Bus:" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#17358A" Margin="0,0,10,0"/>
                <ComboBox x:Name="BusDropdown" Width="250" Height="35" SelectionChanged="BusDropdown_SelectionChanged"
                          Background="White" BorderBrush="#17358A" BorderThickness="1" FontSize="14" Foreground="Black"/>
            </StackPanel>

            <!-- SEAT LAYOUT CONTROL -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <controls:AdminSeatLayoutControl x:Name="SeatLayout" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

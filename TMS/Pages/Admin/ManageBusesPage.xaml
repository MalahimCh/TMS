<Page x:Class="TMS.Pages.Admin.ManageBusesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Manage Buses"
      Background="#F0F2F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#17358A" Grid.Column="0">
            <StackPanel Margin="20">

                <Button Click="Back_Click"
                        Height="40"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        HorizontalContentAlignment="Left"
                        Padding="0"
                        Margin="0,0,0,30">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" Margin="0,0,10,0"/>
                        <TextBlock Text="Back" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="Manage Buses"
                           FontSize="22"
                           Foreground="White"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30" />

                <Button Tag="Add"
                        Click="Sidebar_Click"
                        Height="50"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="White"
                        BorderThickness="1"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Bus" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Tag="Update"
                        Click="Sidebar_Click"
                        Height="50"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="White"
                        BorderThickness="1"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Pencil" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Update Bus" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Tag="Delete"
                        Click="Sidebar_Click"
                        Height="50"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="White"
                        BorderThickness="1"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Delete Bus" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Tag="View"
                        Click="Sidebar_Click"
                        Height="50"
                        Background="Transparent"
                        Foreground="White"
                        BorderBrush="White"
                        BorderThickness="1"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewList" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="View All Buses" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <ContentControl x:Name="ContentArea"/>
        </Grid>

    </Grid>
</Page>
<Page x:Class="TMS.Pages.OtpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="OTP Verification"
      FontFamily="Segoe UI"
      Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.Background>
                <ImageBrush ImageSource="/images/tickit.png" Stretch="UniformToFill"/>
            </Grid.Background>

            <Border Background="#101E3A8A"/>
        </Grid>

        <Grid Grid.Column="1" Background="White">

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">

                <TextBlock Text="OTP Verification" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="#1E3A8A" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,5"/>

                <TextBlock Text="Enter the 6-digit code sent to your email" 
                           FontSize="14" 
                           Foreground="Gray" 
                           HorizontalAlignment="Center" 
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="15,0,0,5"/>

                <Border CornerRadius="25" 
                        Background="#E3F2FD" 
                        Height="50"
                        Margin="0,0,0,20">
                    <TextBox x:Name="txtEmail" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             Padding="20,0,20,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Foreground="#555555"
                             IsReadOnly="True"/>
                </Border>

                <TextBlock Text="OTP Code" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="15,0,0,5"/>

                <Border CornerRadius="25" 
                        Background="#E3F2FD" 
                        Height="50"
                        Margin="0,0,0,25">
                    <TextBox x:Name="txtOtp" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             Padding="20,0,20,0"
                             FontSize="18"
                             FontWeight="Bold"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Foreground="#1E3A8A"
                             MaxLength="6"
                             CharacterCasing="Upper"/>
                </Border>

                <Button Content="Verify OTP" 
                        Height="50" 
                        Margin="0,0,0,15"
                        Foreground="White" 
                        FontWeight="Bold"
                        FontSize="16"
                        BorderThickness="0" 
                        Click="VerifyButton_Click">

                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#42A5F5" Offset="0.0"/>
                            <GradientStop Color="#1565C0" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>

                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="25"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Didn't receive code? " Foreground="#757575"/>
                    <Button Content="Resend OTP" 
                            Background="Transparent" 
                            Foreground="#1E3A8A" 
                            BorderThickness="0" 
                            FontWeight="Bold"
                            Margin="5,0,0,0"
                            Padding="0"
                            Click="ResendButton_Click"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Grid>
</Page>
<Page x:Class="TMS.Pages.SupportStaff.SupportStaffDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:TMS.BLL"
      Background="#F5F7FF">

    <Page.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- STATUS BADGE -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- UNREAD DOT -->
        <Style x:Key="UnreadDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#0D6EFD"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- HOVER CARD -->
        <Style x:Key="HoverCard" TargetType="Border">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDE BAR -->
        <Grid Background="#17358A">
            <StackPanel Margin="20">
                <TextBlock Text="Support Panel" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,10,0,20"/>
                <Button Content="Dashboard" Height="40" Background="#1E3A8A" Foreground="White" BorderThickness="0" Margin="0,5"/>
                <Button Content="Assigned Requests" Height="40" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" Click="Assigned_Click" Margin="0,5"/>
                <Button Content="Profile" Height="40" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" Click="Profile_Click" Margin="0,5"/>
                <Button Content="Logout" Height="40" Background="#C62828" Foreground="White" BorderThickness="0" Click="Logout_Click" Margin="0,40,0,0"/>
            </StackPanel>
        </Grid>

        <!-- RIGHT CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP PROFILE BAR -->
            <Grid Background="#F5F7FF" Grid.Row="0">
                <Grid HorizontalAlignment="Right" Margin="0,10,20,0">

                    <Button x:Name="btnProfile"
                            Content="{Binding UsernameDisplay}"
                            Background="White"
                            Foreground="#1E3A8A"
                            Padding="12,6"
                            BorderBrush="#1E3A8A"
                            BorderThickness="1"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="ProfileMenu_Click"/>

                    <Popup x:Name="ProfilePopup"
                           PlacementTarget="{Binding ElementName=btnProfile}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="False">

                        <Popup.Resources>
                            <Style x:Key="PopupMenuItem" TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Left" Margin="5"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#EEF2FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Popup.Resources>

                        <Border Background="White"
                                Padding="10"
                                CornerRadius="10"
                                BorderBrush="#1E3A8A"
                                BorderThickness="1"
                                Width="180"
                                Margin="0,5,0,0">
                            <StackPanel>
                                <Button Style="{StaticResource PopupMenuItem}" Content="Update Profile" Click="UpdateProfile_Click"/>
                                <Button Style="{StaticResource PopupMenuItem}" Content="Change Password" Click="ChangePassword_Click"/>
                                <Separator Margin="0,5"/>
                                <Button Style="{StaticResource PopupMenuItem}" Content="Logout" Click="Logout_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                </Grid>
            </Grid>

            <!-- MAIN CONTENT -->
            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="30">

                    <!-- WELCOME TEXT -->
                    <TextBlock x:Name="txtWelcomeUser" 
                               FontSize="22" 
                               FontWeight="SemiBold" 
                               Foreground="#1E3A8A" 
                               Margin="0,0,0,10"/>

                    <!-- HEADING -->
                    <TextBlock Text="Assigned Support Requests" FontSize="28" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,20"/>

                    <!-- FILTER BY CATEGORY -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Category:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbCategoryFilter" Width="150" SelectionChanged="CategoryFilter_SelectionChanged">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- STATUS LEGEND -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Status:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="#ADD8E6" Width="20" Height="20" Margin="0,0,2,0"/>
                        <TextBlock Text="Assigned" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="#FFC800" Width="20" Height="20" Margin="0,0,2,0"/>
                        <TextBlock Text="Waiting Support" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="#FFFF99" Width="20" Height="20" Margin="0,0,2,0"/>
                        <TextBlock Text="Waiting Customer" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="#90EE90" Width="20" Height="20" Margin="0,0,2,0"/>
                        <TextBlock Text="Resolved" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- REQUEST LIST -->
                    <ItemsControl x:Name="RequestList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource HoverCard}" Background="White" Padding="20" Margin="0,0,0,10" BorderBrush="#1E3A8A" BorderThickness="1"
                                        MouseLeftButtonUp="Request_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Subject}" FontSize="18" FontWeight="Bold" Foreground="#1E3A8A"/>

                                            <!-- Labels -->
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="Category: " FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Category}" Margin="5,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="Customer: " FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CustomerName}" Margin="5,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="Customer ID: " FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CustomerId}" Margin="5,0,0,0"/>
                                            </StackPanel>

                                            <Border Style="{StaticResource StatusBadge}" Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <Ellipse Grid.Column="1" Style="{StaticResource UnreadDot}" Visibility="{Binding ShowUnreadDot, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

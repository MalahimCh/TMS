<Page x:Class="TMS.Pages.Customer.SearchTicketsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:dto="clr-namespace:TMS.DTO"
      Title="Search Tickets"
      Background="#F0F2F5"
      FontFamily="Segoe UI">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <Button Click="Back_Click"
                    Height="40"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Foreground="#1E3A8A"
                    Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Back to Dashboard" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Text="Search &amp; Book Tickets" FontSize="32" FontWeight="Bold" Foreground="#1E3A8A"/>
            <TextBlock Text="Find available buses and select your seat" FontSize="16" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,30" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.05" Color="Black"/>
            </Border.Effect>

            <WrapPanel Orientation="Horizontal" VerticalAlignment="Bottom">

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="From" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,5"/>
                    <Border Background="#F7F9FC" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Width="180" Height="40">
                        <ComboBox x:Name="cmbOrigin" Padding="10,8" Background="Transparent" BorderThickness="0" IsEditable="True"/>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="To" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,5"/>
                    <Border Background="#F7F9FC" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Width="180" Height="40">
                        <ComboBox x:Name="cmbDestination" Padding="10,8" Background="Transparent" BorderThickness="0" IsEditable="True"/>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Date" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,5"/>
                    <Border Background="#F7F9FC" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Width="150" Height="40">
                        <DatePicker x:Name="dpDate" Padding="5" BorderThickness="0" VerticalContentAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Class" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,5"/>
                    <Border Background="#F7F9FC" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Width="140" Height="40">
                        <ComboBox x:Name="cmbBusType" Padding="10,8" Background="Transparent" BorderThickness="0"/>
                    </Border>
                </StackPanel>

                <Button Content="Search"
                        Width="120" Height="40"
                        Background="#1E3A8A"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="0,0,0,0"
                        VerticalAlignment="Bottom"
                        Click="ViewSchedules_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.05" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="12,12,0,0" Padding="20">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BusClock" Width="24" Height="24" Foreground="White" Margin="0,0,10,0"/>
                        <TextBlock Text="Available Schedules" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="ScheduleCardsPanel" 
                          Grid.Row="1"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE"
                          Background="White"
                          BorderThickness="0"
                          Padding="10">

                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F5F7FA"/>
                            <Setter Property="Foreground" Value="#1E3A8A"/>
                            <Setter Property="Padding" Value="15,12"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Route" Binding="{Binding RouteDisplay}" Width="2*" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Bus" Binding="{Binding BusNumber}" Width="*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding BusType}" Width="*"/>

                        <!-- Separate Departure Date and Time -->
                        <DataGridTextColumn Header="Dep. Date" Binding="{Binding DepartureTime, StringFormat=dd/MM/yyyy}" Width="*"/>
                        <DataGridTextColumn Header="Dep. Time" Binding="{Binding DepartureTime, StringFormat=hh:mm tt}" Width="*"/>

                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="*"/>
                        <DataGridTextColumn Header="Distance (Km)" Binding="{Binding DistanceKm}" Width="*"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=Rs. {0:N0}}" Width="*" Foreground="Green" FontWeight="Bold"/>


                        <DataGridTemplateColumn Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Book Now"
                        Height="30"
                        Background="#1E3A8A"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="Bold"
                        Click="SelectSeats_Click"
                        Tag="{Binding}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="15"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                </DataGrid>
            </Grid>
        </Border>

    </Grid>
</Page>
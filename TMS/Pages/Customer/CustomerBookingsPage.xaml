<Page x:Class="TMS.Pages.Customer.CustomerBookingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="CustomerBookingsPage"
      Background="#F0F2F5"
      FontFamily="Segoe UI">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25">

            <Button Click="Back_Click"
                    Height="40"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Foreground="#1E3A8A"
                    Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" 
                                             Width="24" 
                                             Height="24" 
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text="Back to Dashboard"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Text="Your Bookings"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#1E3A8A"/>

            <TextBlock Text="Manage pending and confirmed bookings easily"
                       FontSize="16"
                       Foreground="Gray"
                       Margin="0,5,0,0"/>
        </StackPanel>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" Margin="0" >

                <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <Border Background="#F57C00" CornerRadius="12,12,0,0" Padding="20">
                            <TextBlock Text="Pending Bookings"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        </Border>

                        <DataGrid x:Name="PendingBookingsDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEEEEE"
                                  Background="White"
                                  BorderThickness="0"
                                  Padding="10">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ref Code" Binding="{Binding BookingReference}" Width="*"/>
                                <DataGridTextColumn Header="Schedule" Binding="{Binding ScheduleDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding BookingDate, StringFormat=dd MMM yyyy}" Width="*"/>
                                <DataGridTextColumn Header="Final Amount" Binding="{Binding FinalAmount, StringFormat=Rs. {0:N0}}" Width="*"/>

                                <DataGridTemplateColumn Header="Actions" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0">
                                                <Button Content="Pay Now"
                                                        Click="PayNow_Click"
                                                        Background="#2E7D32"
                                                        Foreground="White"
                                                        Padding="10,5"
                                                        BorderThickness="0"
                                                        FontWeight="SemiBold"
                                                        />
                                                <Button Content="Cancel"
                                                        Click="CancelBooking_Click"
                                                        Background="#C62828"
                                                        Foreground="White"
                                                        Padding="10,5"
                                                        BorderThickness="0"
                                                        FontWeight="SemiBold"
                                                        />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <Border Background="#1E3A8A" CornerRadius="12,12,0,0" Padding="20">
                            <TextBlock Text="Confirmed Bookings"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                        </Border>

                        <DataGrid x:Name="ConfirmedBookingsDataGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEEEEE"
                                  Background="White"
                                  BorderThickness="0"
                                  Padding="10">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ref Code" Binding="{Binding BookingReference}" Width="*"/>
                                <DataGridTextColumn Header="Schedule" Binding="{Binding ScheduleDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding BookingDate, StringFormat=dd MMM yyyy}" Width="*"/>
                                <DataGridTextColumn Header="Final Amount" Binding="{Binding FinalAmount, StringFormat=Rs. {0:N0}}" Width="*"/>

                                <DataGridTemplateColumn Header="Actions" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Cancel"
                                                    Click="CancelBooking_Click"
                                                    Background="#C62828"
                                                    Foreground="White"
                                                    Padding="10,5"
                                                    BorderThickness="0"
                                                    FontWeight="SemiBold"
                                                    />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>

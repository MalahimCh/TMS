<Page x:Class="TMS.Pages.Customer.PaymentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PaymentPage"
      Background="White">

    <Grid Margin="10">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
            <TextBlock Text="Complete Payment" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>

            <TextBlock Text="Select Payment Method:" FontWeight="Bold"/>
            <ComboBox x:Name="PaymentMethodCombo" Margin="0,5">
                <ComboBoxItem Content="JazzCash"/>
                <ComboBoxItem Content="EasyPaisa"/>
            </ComboBox>

            <TextBlock Text="Total Amount:" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock x:Name="TotalAmountText" FontSize="14" FontWeight="Bold" Margin="0,2"/>

            <Button Content="Pay Now" Margin="0,20,0,0" Background="#10B981" Foreground="White" Click="PayNow_Click"/>
            <Button Content="Cancel and Return to Dashboard" Margin="0,10,0,0" Background="#F59E0B" Foreground="White" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Page>

<Page x:Class="TMS.Pages.Customer.SupportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SupportPage"
      Background="#f0f4f8">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="250"/>
            <!-- Main content area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="#e1ecf9">

            <!-- Back to Dashboard -->
            <Button x:Name="BtnBack" Height="40" Margin="0,0,0,20" Background="Transparent" BorderBrush="Transparent" 
                    HorizontalAlignment="Left" Click="BtnBack_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="← " FontSize="16" FontWeight="Bold" Foreground="#1b3b6f"/>
                    <TextBlock Text="Back to Dashboard" FontSize="14" FontWeight="Bold" Foreground="#1b3b6f"/>
                </StackPanel>
            </Button>

            <TextBlock Text="Customer Support" FontSize="18" FontWeight="Bold" Foreground="#1b3b6f" Margin="5,0,0,20"/>

            <Button x:Name="BtnAddNewRequest" Content="Add New Request" Height="40" Margin="0,0,0,10" 
                    Background="#1b3b6f" Foreground="White" FontWeight="Bold"
                    Click="BtnAddNewRequest_Click"/>

            <Button x:Name="BtnViewRequests" Content="View Previous Requests" Height="40" Margin="0,0,0,10" 
                    Background="#1b3b6f" Foreground="White" FontWeight="Bold"
                    Click="BtnViewRequests_Click"/>
        </StackPanel>

        <!-- Main Content Area -->
        <ContentControl x:Name="MainContentArea" Grid.Column="1" Background="White" Margin="10" />
    </Grid>
</Page>

<Page x:Class="TMS.Pages.ForgotPasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Forgot Password"
      FontFamily="Segoe UI"
      Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 3:2 Ratio (Left side wider) -->
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- LEFT PANEL (FULL SCREEN IMAGE) -->
        <!-- ========================================================= -->
        <Grid Grid.Column="0">
            <Grid.Background>
                <ImageBrush ImageSource="/images/tickit.png" Stretch="UniformToFill"/>
            </Grid.Background>

            <!-- Optional: Subtle Overlay -->
            <Border Background="#101E3A8A"/>

            <!-- Back Button (Floating on top of image) -->
            <Button Click="BtnExit_Click"
                    Height="45"
                    Background="#33000000" 
                    BorderThickness="0"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="15,0,20,0"
                    Margin="20">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="25"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Back" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ========================================================= -->
        <!-- RIGHT PANEL (FORGOT PASSWORD FORM) -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1" Background="White">

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">

                <!-- HEADER -->
                <TextBlock Text="Forgot Password" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="#1E3A8A" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,5"/>

                <TextBlock Text="Enter your email to reset password" 
                           FontSize="14" 
                           Foreground="Gray" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,40"/>

                <!-- 1. EMAIL INPUT -->
                <TextBlock Text="Email" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="15,0,0,5"/>

                <Border CornerRadius="25" 
                        Background="#E3F2FD" 
                        Height="50" 
                        Margin="0,0,0,20">
                    <TextBox x:Name="txtEmail" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             Padding="20,0,20,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Foreground="#1E3A8A"/>
                </Border>

                <!-- 2. OTP INPUT (Conditional) -->
                <TextBlock x:Name="lblOtp" Text="OTP Code" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="15,0,0,5" Visibility="Collapsed"/>

                <Border x:Name="brdOtp" 
                        CornerRadius="25" 
                        Background="#E3F2FD" 
                        Height="50" 
                        Margin="0,0,0,20" 
                        Visibility="Collapsed">
                    <TextBox x:Name="txtOtp" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             Padding="20,0,20,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Foreground="#1E3A8A"/>
                </Border>

                <!-- 3. NEW PASSWORD (Conditional) -->
                <TextBlock x:Name="lblNewPassword" Text="New Password" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="15,0,0,5" Visibility="Collapsed"/>

                <Grid x:Name="grdNewPassword" Visibility="Collapsed" Margin="0,0,0,20">
                    <Border CornerRadius="25" Background="#E3F2FD" Height="50">
                        <Grid>
                            <!-- Hidden Password -->
                            <Border x:Name="PasswordBorderNew" Background="Transparent" BorderThickness="0">
                                <PasswordBox x:Name="pwdNew"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="20,0,45,0" 
                                             FontSize="14"
                                             VerticalContentAlignment="Center"
                                             Foreground="#1E3A8A"
                                             PasswordChanged="pwdNew_PasswordChanged"/>
                            </Border>

                            <!-- Visible Password -->
                            <Border x:Name="PasswordTextBorderNew" Background="Transparent" BorderThickness="0" Visibility="Collapsed">
                                <TextBox x:Name="txtPasswordVisibleNew"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="20,0,45,0"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"
                                         Foreground="#1E3A8A"
                                         TextChanged="txtPasswordVisibleNew_TextChanged"/>
                            </Border>

                            <!-- Eye Icon -->
                            <Button x:Name="btnTogglePasswordNew"
                                    Width="30" Height="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0"
                                    Click="TogglePasswordVisibilityNew_Click">
                                <materialDesign:PackIcon x:Name="EyePackNew" Kind="Eye" Foreground="#1E3A8A" Opacity="0.6"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 4. CONFIRM PASSWORD (Conditional) -->
                <TextBlock x:Name="lblConfirmPassword" Text="Confirm Password" FontWeight="SemiBold" Foreground="#1E3A8A" Margin="15,0,0,5" Visibility="Collapsed"/>

                <Grid x:Name="grdConfirmPassword" Visibility="Collapsed" Margin="0,0,0,20">
                    <Border CornerRadius="25" Background="#E3F2FD" Height="50">
                        <Grid>
                            <!-- Hidden Password -->
                            <Border x:Name="PasswordBorderConfirm" Background="Transparent" BorderThickness="0">
                                <PasswordBox x:Name="pwdConfirm"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="20,0,45,0" 
                                             FontSize="14"
                                             VerticalContentAlignment="Center"
                                             Foreground="#1E3A8A"
                                             PasswordChanged="pwdConfirm_PasswordChanged"/>
                            </Border>

                            <!-- Visible Password -->
                            <Border x:Name="PasswordTextBorderConfirm" Background="Transparent" BorderThickness="0" Visibility="Collapsed">
                                <TextBox x:Name="txtPasswordVisibleConfirm"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="20,0,45,0"
                                         FontSize="14"
                                         VerticalContentAlignment="Center"
                                         Foreground="#1E3A8A"
                                         TextChanged="txtPasswordVisibleConfirm_TextChanged"/>
                            </Border>

                            <!-- Eye Icon -->
                            <Button x:Name="btnTogglePasswordConfirm"
                                    Width="30" Height="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0"
                                    Click="TogglePasswordVisibilityConfirm_Click">
                                <materialDesign:PackIcon x:Name="EyePackConfirm" Kind="Eye" Foreground="#1E3A8A" Opacity="0.6"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ACTION BUTTON -->
                <Button x:Name="btnAction"
                        Content="Send OTP" 
                        Height="50" 
                        Margin="0,10,0,15"
                        Foreground="White" 
                        FontWeight="Bold"
                        FontSize="16"
                        BorderThickness="0" 
                        Click="ActionButton_Click">

                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#42A5F5" Offset="0.0"/>
                            <GradientStop Color="#1565C0" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>

                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="25"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- RESEND OTP BUTTON (Conditional) -->
                <Button x:Name="btnResend"
                        Content="Resend Code" 
                        Height="30" 
                        Background="Transparent" 
                        Foreground="#1E3A8A" 
                        BorderThickness="0" 
                        FontWeight="SemiBold"
                        Margin="0,0,0,0"
                        Padding="0"
                        Visibility="Collapsed"
                        Click="ResendButton_Click"/>

            </StackPanel>
        </Grid>
    </Grid>
</Page>
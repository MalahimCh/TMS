<Window x:Class="TMS.Controls.Customer.GenderSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Gender" Height="150" Width="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#F3F4F6"
        ShowInTaskbar="False">

    <Border CornerRadius="10" Background="White" Padding="15" BorderBrush="#DDD" BorderThickness="1">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" >

            <TextBlock Text="Select Your Gender" 
                       FontWeight="Bold" 
                       FontSize="16" 
                       Foreground="#1E3A8A" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <Button x:Name="MaleButton" Content="Male" Width="90" Height="35" Margin="5"
                        Background="#1E40AF" Foreground="White" FontWeight="SemiBold"
                        Cursor="Hand" BorderThickness="0"
                        Padding="5">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1E40AF"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2563EB"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="FemaleButton" Content="Female" Width="90" Height="35" Margin="5"
                        Background="#DB2777" Foreground="White" FontWeight="SemiBold"
                        Cursor="Hand" BorderThickness="0"
                        Padding="5">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#DB2777"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F43F5E"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#BE185D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

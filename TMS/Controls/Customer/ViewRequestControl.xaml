<UserControl x:Class="TMS.Pages.Customer.ViewRequestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TMS.Pages.Customer"
             xmlns:conv="clr-namespace:TMS.BLL"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </UserControl.Resources>

    <Grid Background="#f0f4f8" Margin="10">
        <StackPanel>

            <!-- Heading -->
            <TextBlock Text="Your Support Requests" 
                       FontSize="18" FontWeight="Bold" 
                       Foreground="#1b3b6f" Margin="0,0,0,10"/>

            <!-- Status Legend -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Status Legend:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Border Background="#ADD8E6" Width="20" Height="20" Margin="0,0,2,0"/>
                <TextBlock Text="Assigned" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Border Background="#FFC800" Width="20" Height="20" Margin="0,0,2,0"/>
                <TextBlock Text="Waiting Support" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Border Background="#FFFF99" Width="20" Height="20" Margin="0,0,2,0"/>
                <TextBlock Text="Waiting Customer" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Border Background="#90EE90" Width="20" Height="20" Margin="0,0,2,0"/>
                <TextBlock Text="Resolved" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Requests List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="500">
                <ListBox x:Name="RequestsList" MouseDoubleClick="RequestsList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10" Margin="0,0,0,10"
                                    Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Subject}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Category}" FontStyle="Italic" FontSize="12"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}" FontSize="12"/>
                                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

        </StackPanel>
    </Grid>
</UserControl>

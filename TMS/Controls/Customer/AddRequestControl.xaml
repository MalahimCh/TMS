<UserControl x:Class="TMS.Pages.Customer.AddRequestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="Auto" Height="Auto" Background="White">

    <Border CornerRadius="10" Background="White" Padding="20" Margin="10" 
            BorderBrush="#c3d2e5" BorderThickness="1" >
        <StackPanel>

            <TextBlock Text="Submit a New Support Request" 
                       FontSize="20" FontWeight="Bold" Foreground="#1b3b6f" Margin="0,0,0,20"/>

            <TextBlock Text="Category:" FontWeight="Bold" Margin="0,5,0,0"/>
            <ComboBox x:Name="CategoryComboBox" Margin="0,0,0,15">
                <ComboBoxItem Content="Complaint"/>
                <ComboBoxItem Content="Inquiry"/>
                <ComboBoxItem Content="LostAndFound"/>
                <ComboBoxItem Content="PaymentIssue"/>
                <ComboBoxItem Content="TechnicalIssue"/>
                <ComboBoxItem Content="Suggestion"/>
            </ComboBox>

            <TextBlock Text="Subject:" FontWeight="Bold" Margin="0,5,0,0"/>
            <TextBox x:Name="SubjectTextBox" Margin="0,0,0,15"/>

            <TextBlock Text="Description:" FontWeight="Bold" Margin="0,5,0,0"/>
            <TextBox x:Name="DescriptionTextBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

            <Button Content="Submit Request" Width="150" Height="35" Background="#1b3b6f" Foreground="White" FontWeight="Bold"
                    HorizontalAlignment="Left"
                    Click="SubmitRequest_Click"/>

        </StackPanel>
    </Border>
</UserControl>

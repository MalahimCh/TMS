<UserControl x:Class="TMS.Pages.Customer.RequestDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TMS.BLL"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColorConverter"/>

        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1E3A8A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D2C8B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#162D6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="6" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#f0f4f8" Margin="10">
        <StackPanel>

            <!-- Back Button -->
            <Button Content="← Back to Requests" Style="{StaticResource ModernButton}" Width="150" Click="BackButton_Click"/>

            <!-- Original Request -->
            <Border CornerRadius="8" Padding="10" Margin="0,10,0,10"
                    Background="{Binding Request.Status, Converter={StaticResource StatusToColorConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding Request.Subject}" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="{Binding Request.Category}" FontStyle="Italic" FontSize="14"/>
                    <TextBlock Text="{Binding Request.CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" FontSize="12"/>
                    <TextBlock Text="{Binding Request.Description}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="Status:" FontWeight="Bold" FontSize="12" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Request.Status}" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Status / Reply Legend -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Rectangle Width="20" Height="20" Fill="#4A90E2" Margin="0,0,5,0"/>
                    <TextBlock Text="Support message" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Rectangle Width="20" Height="20" Fill="#FFA726" Margin="0,0,5,0"/>
                    <TextBlock Text="Customer message" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="20" Height="20" Fill="#66BB6A" Margin="0,0,5,0"/>
                    <TextBlock Text="Resolved" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Replies List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Height="300">
                <ItemsControl x:Name="RepliesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="10" Margin="0,0,0,8"
                                    Background="{Binding ReplyBackground}" MaxWidth="500">
                                <StackPanel>
                                    <TextBlock Text="{Binding UserName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" FontSize="10" Foreground="#555"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Add Reply -->
            <TextBlock Text="Add Your Reply:" FontWeight="Bold" FontSize="14" Margin="0,10,0,2"/>
            <TextBox x:Name="ReplyTextBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" Margin="0,0,0,5"/>
            <Button Content="Send Reply" Style="{StaticResource ModernButton}" Width="120" Click="SendReply_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
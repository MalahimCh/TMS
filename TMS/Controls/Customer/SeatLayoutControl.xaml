<UserControl x:Class="TMS.Controls.Customer.SeatLayoutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Seats area -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom overlay -->
        </Grid.RowDefinitions>

        <!-- Seats Area -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <!-- This Grid will be populated dynamically -->
            <Grid x:Name="SeatsGrid" Margin="10"/>
        </ScrollViewer>

        <!-- Bottom Overlay: Selected Seats + Total Price -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="Selected Seats: " FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="SelectedSeatsText" Text="None" Margin="5,0"/>
            <TextBlock Text=" | Total: " FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="TotalPriceText" Text="Rs. 0" Margin="5,0"/>
            <Button Content="Book Seats" Margin="10,0,0,0" Click="BookSeats_Click" Background="#1E3A8A" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>

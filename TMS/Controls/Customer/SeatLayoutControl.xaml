<UserControl x:Class="TMS.Controls.Customer.SeatLayoutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- Seats Area -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="SeatsGrid" Margin="10"/>
        </ScrollViewer>

        <!-- Summary Sidebar -->
        <StackPanel Grid.Column="1" Margin="10" Background="#F5F5F5"  VerticalAlignment="Top">
            <TextBlock Text="Booking Summary" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="Selected Seats:" FontWeight="Bold"/>
            <ItemsControl x:Name="SelectedSeatsList" Margin="0,5,0,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{Binding SeatNumber}" Width="40"/>
                            <TextBlock Text="(" />
                            <TextBlock Text="{Binding Gender}" />
                            <TextBlock Text=") - " />
                            <TextBlock Text="{Binding Price, StringFormat=Rs. {0:N0}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Total:" FontWeight="Bold" Margin="0,10,0,0"/>
            <TextBlock x:Name="TotalPriceTextSidebar" FontSize="14" FontWeight="Bold" Margin="0,2,0,10"/>

            <Button Content="Book Now / Pay Later" Margin="0,5" Click="PayLater_Click" Background="#F59E0B" Foreground="White"/>
            <TextBlock Text="* Booking must be confirmed within 2 hours or it will be cancelled" FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,10"/>

            <Button Content="Pay Now" Margin="0,5" Click="PayNow_Click" Background="#10B981" Foreground="White"/>
        </StackPanel>
    </Grid>
</UserControl>
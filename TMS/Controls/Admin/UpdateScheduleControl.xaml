<UserControl x:Class="TMS.Controls.Admin.UpdateScheduleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800"
             FontFamily="Segoe UI">

    <!-- Gray Background -->
    <Grid Background="#F0F2F5">

        <!-- Centered White Card -->
        <Border Background="White" 
                Width="500" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                CornerRadius="12"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                Margin="0,20">

            <!-- Shadow Effect -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.1" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Header -->
                    <RowDefinition Height="*"/>
                    <!-- Scrollable Content -->
                    <RowDefinition Height="Auto"/>
                    <!-- Footer Button -->
                </Grid.RowDefinitions>

                <!-- 1. HEADER (Blue) -->
                <Border Grid.Row="0" 
                        Background="#1E3A8A" 
                        CornerRadius="12,12,0,0" 
                        Padding="20">
                    <TextBlock Text="Update Schedule" 
                               Foreground="White" 
                               FontSize="20" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- 2. SCROLLABLE FORM -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,20,30,10">
                    <StackPanel>

                        <!-- SELECTION -->
                        <TextBlock Text="Select Schedule to Update" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                        <Border Background="#F7F9FC" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20">
                            <ComboBox x:Name="cmbScheduleUpdate" 
                                      Padding="10" 
                                      Background="Transparent" 
                                      BorderThickness="0"
                                      SelectionChanged="CmbScheduleUpdate_SelectionChanged"/>
                        </Border>

                        <!-- RECURRING OPTIONS (Conditional Panel) -->
                        <!-- Styled as an 'Amber' Warning Box so it stands out -->
                        <StackPanel x:Name="RecurringUpdateModePanel" Visibility="Collapsed" Margin="0,0,0,20">
                            <Border Background="#FFF3E0" BorderBrush="#FFCC80" BorderThickness="1" CornerRadius="5" Padding="15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#EF6C00" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Recurring Schedule Options" FontWeight="Bold" Foreground="#EF6C00" FontSize="14"/>
                                    </StackPanel>

                                    <TextBlock Text="This schedule repeats. How would you like to apply changes?" FontSize="13" Foreground="#5D4037" Margin="0,0,0,10"/>

                                    <RadioButton x:Name="rbUpdateThisInstance" Content="Update this instance only" GroupName="UpdateMode" Margin="0,0,0,5" Checked="UpdateOption_Checked" IsChecked="True"/>
                                    <RadioButton x:Name="rbUpdateAllFuture" Content="Update all future schedules" GroupName="UpdateMode" Checked="UpdateOption_Checked"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- SCHEDULE FIELDS -->
                        <StackPanel x:Name="SchedulePanelUpdate" Visibility="Collapsed">

                            <!-- Bus Selection -->
                            <TextBlock Text="Select Bus" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                            <Border Background="#F7F9FC" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,15">
                                <ComboBox x:Name="cmbBusUpdate" Padding="10" Background="Transparent" BorderThickness="0"/>
                            </Border>

                            <!-- Route Selection -->
                            <TextBlock Text="Select Route" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                            <Border Background="#F7F9FC" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,15">
                                <ComboBox x:Name="cmbRouteUpdate" Padding="10" Background="Transparent" BorderThickness="0" SelectionChanged="CmbRouteUpdate_SelectionChanged"/>
                            </Border>

                            <!-- Price Input -->
                            <TextBlock Text="Price" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                            <Border Background="#F7F9FC" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,15">
                                <TextBox x:Name="txtPriceUpdate" Padding="10" Background="Transparent" BorderThickness="0"/>
                            </Border>

                            <Separator Background="#E0E0E0" Margin="0,10,0,20"/>

                            <!-- DEPARTURE ROW -->
                            <TextBlock Text="Departure Details" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Date" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                                    <DatePicker x:Name="dpDepartureDateUpdate" Padding="5" SelectedDateChanged="DepartureDateUpdate_SelectedDateChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Time" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                                    <xctk:TimePicker x:Name="tpDepartureTimeUpdate" Padding="5" ValueChanged="DepartureTimeUpdate_ValueChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- ARRIVAL ROW -->
                            <TextBlock Text="Arrival Details (Calculated)" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Date" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                                    <!-- Gray background to indicate ReadOnly -->
                                    <DatePicker x:Name="dpArrivalDateUpdate" Padding="5" IsEnabled="False" Background="#EEEEEE"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Time" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>
                                    <xctk:TimePicker x:Name="tpArrivalTimeUpdate" Padding="5" IsEnabled="False" Background="#EEEEEE"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- 3. FOOTER BUTTON (Blue Animation) -->
                <Border Grid.Row="2" Padding="30,0,30,30">
                    <Button Content="Update Schedule"
                            Height="45"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderThickness="0"
                            Click="UpdateScheduleUpdate_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1E3A8A"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#152869"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2A4CB3"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Border>

            </Grid>
        </Border>
    </Grid>
</UserControl>
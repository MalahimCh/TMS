<UserControl x:Class="TMS.Controls.Admin.DeletePolicyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <Grid Background="#F0F2F5">
        <Border Background="White" 
                Width="400" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                CornerRadius="12"
                BorderBrush="#E0E0E0"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.1" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1E3A8A" CornerRadius="12,12,0,0" Padding="20">
                    <TextBlock Text="Delete Cancellation Policy" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="30,25,30,25">
                    <TextBlock Text="Select Policy" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbPolicies" SelectionChanged="CmbPolicies_SelectionChanged" Padding="10" FontSize="14" Background="#F7F9FC" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,15"/>

                    <TextBlock Text="Refund Percentage (%)" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtRefund" Padding="10" FontSize="14" Background="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="1" IsReadOnly="True" Margin="0,0,0,15"/>

                    <TextBlock Text="Cutoff Hours Before Departure" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtCutoffHours" Padding="10" FontSize="14" Background="#EEEEEE" BorderBrush="#E0E0E0" BorderThickness="1" IsReadOnly="True" Margin="0,0,0,15"/>

                    <CheckBox x:Name="chkIsActive" Content="Active" IsEnabled="False" FontWeight="SemiBold" Margin="0,0,0,15"/>
                </StackPanel>

                <Button Content="Delete Policy"
                        Grid.Row="2"
                        Margin="30,0,30,30"
                        Height="45"
                        Background="#F44336"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Click="DeletePolicy_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="TMS.Controls.Admin.DeleteScheduleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             FontFamily="Segoe UI">

    <Grid Background="#F0F2F5">

        <Border Background="White" 
                Width="450" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                CornerRadius="12"
                BorderBrush="#E0E0E0"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.1" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" 
                        Background="#1E3A8A" 
                        CornerRadius="12,12,0,0" 
                        Padding="20">
                    <TextBlock Text="Delete Schedule" 
                               Foreground="White" 
                               FontSize="20" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="30,25,30,30">

                    <TextBlock Text="Select Schedule" FontWeight="SemiBold" Foreground="#666666" Margin="0,0,0,5"/>

                    <Border Background="#F7F9FC" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,20">
                        <ComboBox x:Name="cmbScheduleDelete" 
                                  Padding="10" 
                                  FontSize="14" 
                                  Background="Transparent" 
                                  BorderThickness="0"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="CmbScheduleDelete_SelectionChanged"/>
                    </Border>

                    <StackPanel x:Name="RecurringWarningPanel" Visibility="Collapsed" Margin="0,0,0,25">
                        <Border Background="#FFEBEE" BorderBrush="#FFCDD2" BorderThickness="1" CornerRadius="5" Padding="15">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" Foreground="#D32F2F" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,10,0"/>

                                <TextBlock Text="This schedule is part of a recurring series. Deleting it will remove all future occurrences!" 
                                           Foreground="#D32F2F" 
                                           TextWrapping="Wrap" 
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Width="300"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Content="Delete Schedule"
                            Width="200"
                            Height="45"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderThickness="0"
                            Click="DeleteScheduleDelete_Click">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F44336"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#B71C1C"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E53935"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>